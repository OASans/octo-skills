#!/usr/bin/env bash
# Template for setup/.env — copy it, then fill in your own values:
#
#     cp setup/.env.example setup/.env
#
# .env is gitignored. Personal identity and internal network details live there
# and never get committed; this template ships placeholders only.
#
# Bash syntax — the install scripts `source` this file (WEB_ALLOWED_IPS is a real
# bash array), so it is not a generic dotenv file.

# ---------- git identity (every platform) ----------
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# ---------- Linux server hardening (install-linux.sh only) ----------
# Everything below is ignored by the macOS and WSL2 scripts.

# CIDR of the LAN allowed to SSH in. Everything else is denied by ufw.
# Find yours with:  ip -4 -o addr show "$(ip -4 route show default | awk '{print $5; exit}')"
INTERNAL_SSH_CIDR="192.168.1.0/24"
SSH_PORT=22

# Ports your internal web apps listen on (comma-separated; ranges use `low:high`).
WEB_PORT="3000:3010,8000:8010"

# Hosts allowed to reach WEB_PORT. Each entry is "IP label" — the label becomes the
# ufw rule comment, so `ufw status` tells the rules apart. While this array is empty
# the web firewall rule is SKIPPED and the port stays closed.
WEB_ALLOWED_IPS=(
  # "192.168.1.10 my-laptop"
  # "192.168.1.11 other-laptop"
)
